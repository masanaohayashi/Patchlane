# Only reviewed product directories and repository metadata are eligible.
/*
!/.gitignore
!/README.md
!/Package.swift
!/Sources/
!/Shared/
!/Driver/
!/Broker/
!/Resources/
!/Uninstaller/
!/Tests/
!/Tools/
!/scripts/
!/docs/
!/LICENSE
!/.github/

