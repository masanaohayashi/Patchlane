.build/
build/
.local/
.swiftpm/
.DS_Store
._*
*.log
*.xcuserstate
xcuserdata/
.env
.env.*
*.p12
*.pfx
*.p8
*.key
*.mobileprovision
*.provisionprofile
*.app/
*.driver/
*.pkg
*.dmg
*.zip
